    "bsInsight": "Valorant\u7684\u9ad8\u4ef7\u76ae\u80a4\u5df2\u7ecf\u8bc1\u660e\u201c\u89c6\u89c9\u514b\u5236\u2260\u4f4e\u4ed8\u8d39\u610f\u613f\u201d\u2014\u2014\u6838\u5fc3\u7528\u6237\u53cd\u800c\u538c\u5026\u8fc7\u5ea6\u8bbe\u8ba1\u3002\u4f46\u524d\u63d0\u662f\u7528\u6237\u7fa4\u5df2\u7ecf\u7ecf\u5386\u4e86\u7279\u6548\u5ba1\u7f8e\u75b2\u52b3\u671f\u3002BS\u5f53\u524d\u9636\u6bb5\u53ef\u80fd\u8fd8\u6ca1\u5230\u8fd9\u4e2a\u62d0\u70b9\uff0c\u66f4\u9002\u5408\u5148\u7528\u9ad8\u5bc6\u5ea6\u7279\u6548\u5efa\u7acb\u54c1\u724c\u8ba4\u77e5\uff0c\u518d\u9010\u6b65\u63a8\u51fa\u201c\u7cbe\u7b80\u9ad8\u7aef\u7ebf\u201d\u505a\u4ef7\u683c\u5206\u5c42\u3002",
