    "title": "\u9006\u6218\u672a\u6765\u300c\u70bc\u72f1\u880e\u738b-\u7c89\u58a8\u91cd\u534e\u300d\u5178\u85cf\u6b66\u5668 \u2014 \u4e8c\u6b21\u5143\u98ce\u683c\u67aa\u68b0\u7684\u8bbe\u8ba1\u8fb9\u754c\u4e0e\u4e89\u8bae",
    "highlights": "S2\u6a31\u4e4b\u6e0a\u8d5b\u5b63\u5178\u85cf\u6b66\u5668\uff0c13.6\u4e07\u64ad\u653e\u3002\u68c0\u89c6\u52a8\u753b\u8d853\u5206\u949f\uff08\u6781\u7aef\u957f\u5ea6\uff09\uff0c\u4e8c\u6b21\u5143\u7f8e\u672f\u98ce\u683c\u5f3a\u70c8\uff0c\u56de\u76fe\u65f6\u89e6\u53d1\u9690\u85cf\u7279\u6548\u5f69\u86cb\u3002\u793e\u533a\u53cd\u9988\u4e24\u6781\u5206\u5316\u3002",
    "designAnalysis": "\u2022 \u6781\u7aef\u957f\u5ea6\u68c0\u89c6\u52a8\u753b\uff083min+\uff09\uff1a\u628a\u6b66\u5668\u68c0\u89c6\u505a\u6210\u201c\u5fae\u578b\u52a8\u753b\u77ed\u7247\u201d\n\n\u2022 \u9690\u85cf\u5f69\u86cb\u673a\u5236\uff1a\u56de\u76fe\u89e6\u53d1\u72ec\u5360\u7279\u6548\uff0c\u589e\u52a0\u53d1\u73b0\u4e50\u8da3\n\n\u2022 \u5f3a\u4e8c\u6b21\u5143\u98ce\u683c\uff1a\u7c89+\u9ed1\u914d\u8272\uff0c\u4e0ePVE\u5c04\u51fb\u6e38\u620f\u6c1b\u56f4\u5f62\u6210\u5f20\u529b",
    "bsInsight": "\u68c0\u89c6\u52a8\u753b\u8d85\u957f\u662f\u9006\u6218\u672a\u6765\u7684\u5dee\u5f02\u5316\u5356\u70b9\uff0c\u4f46\u672c\u8d28\u662fPVE\u573a\u666f\u5141\u8bb8\u73a9\u5bb6\u201c\u505c\u4e0b\u6765\u6b23\u8d4f\u201d\u2014\u2014\u8fd9\u5728PVP\u9ad8\u5f3a\u5ea6\u5bf9\u6297\u6e38\u620f\u91cc\u4e0d\u6210\u7acb\u3002BS\u5982\u679c\u8981\u501f\u9274\u201c\u9690\u85cf\u5f69\u86cb\u7279\u6548\u201d\u601d\u8def\uff0c\u66f4\u9002\u5408\u7ed1\u5b9a\u51fb\u6740/\u8fde\u6740\u7b49\u9ad8\u5149\u65f6\u523b\u800c\u975e\u68c0\u89c6\u3002\u53e6\u5916\u4e8c\u6b21\u5143\u98ce\u683c\u5728\u5168\u7403\u5e02\u573a\u9700\u8981\u8003\u8651\u6587\u5316\u9002\u914d\u3002",
