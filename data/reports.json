    "designAnalysis": "\u2022 \u7075\u4f53\u4f34\u968f\u7cfb\u7edf\uff1a\u51fb\u6740/\u53d7\u4f24/\u5904\u51b3\u5206\u522b\u89e6\u53d1\u4e0d\u540c\u7684NPC\u8054\u52a8\u52a8\u753b\n\n\u2022 \u201c\u60c5\u611f\u5316\u8bbe\u8ba1\u201d\u8def\u7ebf\uff1a\u7528\u5144\u5f1f\u60c5\u53d9\u4e8b\u5305\u88c5\u7eaf\u89c6\u89c9\u4ed8\u8d39\u5185\u5bb9\n\n\u2022 \u795e\u8bdd\u7ea7\u5b9a\u4f4d\uff1a\u5168\u9762\u5347\u7ea7\u6548\u679c\u5c55\u793a\uff08\u975e\u5355\u7eaf\u6a21\u578b\u6362\u8272\uff09",
    "bsInsight": "\u53d9\u4e8b\u7ed1\u5b9a\u578b\u76ae\u80a4\u7684\u6838\u5fc3\u95ee\u9898\u662f\u201c\u770b\u4e00\u6b21\u5c31\u591f\u4e86\u201d\u2014\u2014\u7b2c\u4e00\u6b21\u5904\u51b3\u52a8\u753b\u60ca\u8273\uff0c\u7b2c\u5341\u6b21\u5c31\u662f\u7b49\u5f85\u3002CODM\u901a\u8fc7\u591a\u573a\u666f\u5dee\u5f02\u5316\u7f13\u89e3\uff0c\u4f46\u957f\u671f\u7559\u5b58\u4ef7\u503c\u53d6\u51b3\u4e8e\u793e\u4ea4\u5c55\u793a\u9891\u7387\u3002\u5bf9BS\u6765\u8bf4\u8fd9\u79cd\u8bbe\u8ba1\u9002\u5408\u8d5b\u5b63\u65d7\u8230\u6b3e\u505a\u8bdd\u9898\u5f15\u7206\uff0c\u4f46\u4e0d\u9002\u5408\u6279\u91cf\u590d\u5236\u2014\u2014\u60c5\u611f\u53d9\u4e8b\u7684\u8fb9\u9645\u6548\u7528\u9012\u51cf\u6781\u5feb\u3002",
